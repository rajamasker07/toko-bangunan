PORT=5000
DATABASE_URL=postgresql://postgres:root@localhost:5432/toko_bangunan
PGUSER=postgres
PGPASSWORD=root
PGHOST=localhost
PGPORT=5432
PGDATABASE=toko_bangunan
NODE_ENV=development

# Auth & JWT Security
# Production wajib mengisi secret acak minimal 32 karakter
JWT_ACCESS_SECRET=replace-with-a-random-32-plus-char-secret-key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_TTL_DAYS=7
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# First-Run Bootstrap Owner (dipakai hanya saat tabel users masih kosong)
# Jika BOOTSTRAP_OWNER_PASSWORD dikosongkan, sistem akan membuat password acak 1x pakai di log server
BOOTSTRAP_OWNER_USERNAME=owner
BOOTSTRAP_OWNER_NAME=Pemilik Toko
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_FORCE_PASSWORD_CHANGE=true
