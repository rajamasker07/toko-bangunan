PORT=5000
DATABASE_URL=postgresql://postgres:root@localhost:5432/toko_bangunan
PGUSER=postgres
PGPASSWORD=root
PGHOST=localhost
PGPORT=5432
PGDATABASE=toko_bangunan
NODE_ENV=development

# Auth & JWT Security
# Production wajib mengisi secret acak minimal 32 karakter
JWT_ACCESS_SECRET=replace-with-a-random-32-plus-char-secret-key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_TTL_DAYS=7
JWT_REFRESH_GRACE_WINDOW_SECONDS=15
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# First-Run Bootstrap Owner (dipakai hanya saat tabel users masih kosong)
# Jika BOOTSTRAP_OWNER_PASSWORD dikosongkan, sistem akan membuat password acak 1x pakai di log server
BOOTSTRAP_OWNER_USERNAME=owner
BOOTSTRAP_OWNER_NAME=Pemilik Toko
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_FORCE_PASSWORD_CHANGE=true

# Smart Search Local AI Cross-Encoder Reranker (Tahap 3 - Opsional)
# Aktifkan 'true' jika server memiliki sisa RAM >= 512MB untuk presisi maksimal
RERANKER_ENABLED=false
RERANKER_MODEL=SugoLabs/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_DTYPE=q8
RERANKER_MIN_SCORE=0.25
RERANKER_TOP_K=10
RERANKER_TIMEOUT_MS=3500
